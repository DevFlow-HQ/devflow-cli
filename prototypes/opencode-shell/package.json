{
  "name": "crucible-shell-prototype",
  "private": true,
  "type": "module",
  "description": "THROWAWAY prototype for DevFlow-HQ/devflow-cli#6. Not production. Never imported by src/.",
  "scripts": {
    "shell:bun": "bun src/main.mjs",
    "shell:node": "node --experimental-ffi --no-warnings src/main.mjs",
    "spike:bun": "bun src/spike.mjs",
    "spike:node": "node --experimental-ffi --no-warnings src/spike.mjs",
    "test:seam": "node --test test/seam.test.mjs",
    "test:pty": "node --test test/lifecycle.pty.test.mjs",
    "check:real-terminal": "node --experimental-ffi --no-warnings scripts/real-terminal-check.mjs",
    "natives": "node scripts/install-natives.mjs",
    "package:bun": "bun build --compile src/main.mjs --outfile dist/crucible-shell",
    "smoke:packaged": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "1.9.12",
    "node-pty": "1.1.0"
  }
}
