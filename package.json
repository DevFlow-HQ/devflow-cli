{
  "name": "devflow-cli",
  "version": "0.1.0",
  "author": "DevFlow-HQ",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "devflow": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm test && npm run build && npm run test:package",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node scripts/run-tests.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "prompts"
  ],
  "dependencies": {
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "enquirer": "^2.4.1",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.5",
    "globby": "^16.2.0",
    "node-pty": "1.1.0",
    "ora": "^9.4.0",
    "strip-ansi": "^7.2.0",
    "which": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.43",
    "@types/which": "^3.0.4",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "description": "Claude and Codex orchestrator that turns development tasks into PR-ready changes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevFlow-HQ/devflow-cli.git"
  },
  "homepage": "https://github.com/DevFlow-HQ/devflow-cli#readme",
  "bugs": {
    "url": "https://github.com/DevFlow-HQ/devflow-cli/issues"
  },
  "keywords": [
    "ai",
    "cli",
    "coding-agent",
    "claude",
    "codex",
    "orchestrator",
    "devtools"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.9.0"
  },
  "contributors": [
    "Rohan Garg <gargrohan831@gmail.com> (https://rgdev.xyz)"
  ]
}
